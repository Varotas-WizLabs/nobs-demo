{"run_id":68,"cues":[{"idx":0,"start_sec":0.1,"end_sec":2.79,"text":"Почему небо голубое? Разбираться будем с","voice_change":false},{"idx":1,"start_sec":2.8,"end_sec":5.49,"text":"помощью стержня для клеевого пистолета,","voice_change":false},{"idx":2,"start_sec":5.5,"end_sec":8.49,"text":"фонарика, а затем дополнительные эффекты","voice_change":false},{"idx":3,"start_sec":8.5,"end_sec":11.49,"text":"посмотрим с помощью светодиодной лампы с","voice_change":false},{"idx":4,"start_sec":11.5,"end_sec":14.59,"text":"лазерной указкой и парафина. Атмосфера","voice_change":false},{"idx":5,"start_sec":14.6,"end_sec":17.09,"text":"Земли изображена здесь непропорционально","voice_change":false},{"idx":6,"start_sec":17.1,"end_sec":19.19,"text":"толстой, но иначе нам неудобно будет","voice_change":false},{"idx":7,"start_sec":19.2,"end_sec":21.49,"text":"рисовать. Это наблюдатель, это горизонт","voice_change":false},{"idx":8,"start_sec":21.5,"end_sec":24.39,"text":"наблюдателя, и ниже горизонта","voice_change":false},{"idx":9,"start_sec":24.4,"end_sec":26.59,"text":"наблюдатель атмосферу не vidit, vidit","voice_change":false},{"idx":10,"start_sec":26.6,"end_sec":29.39,"text":"только вот эту часть. У нас день, и","voice_change":false},{"idx":11,"start_sec":29.4,"end_sec":31.29,"text":"солнечный свет падает на наблюдателя","voice_change":false},{"idx":12,"start_sec":31.3,"end_sec":33.69,"text":"сверху. Солнечный свет неоднороден. В","voice_change":false},{"idx":13,"start_sec":33.7,"end_sec":35.69,"text":"русской традиции принято считать, что","voice_change":false},{"idx":14,"start_sec":35.7,"end_sec":37.39,"text":"видимая часть солнечного излучения","voice_change":false},{"idx":15,"start_sec":37.4,"end_sec":39.79,"text":"состоит из семи цветов.","voice_change":false},{"idx":16,"start_sec":39.8,"end_sec":42.19,"text":"Красный рассеивается атмосферой меньше","voice_change":false},{"idx":17,"start_sec":42.2,"end_sec":44.59,"text":"всего, фиолетовый больше всего. Что","voice_change":false},{"idx":18,"start_sec":44.6,"end_sec":46.79,"text":"такое рассеяние, можно посмотреть,","voice_change":false},{"idx":19,"start_sec":46.8,"end_sec":48.79,"text":"посветив лазерной указкой на пластик","voice_change":false},{"idx":20,"start_sec":48.8,"end_sec":50.89,"text":"светодиодной лампы. У меня есть указка","voice_change":false},{"idx":21,"start_sec":50.9,"end_sec":52.79,"text":"только с красным и зелёным лучом,","voice_change":false},{"idx":22,"start_sec":52.8,"end_sec":55.09,"text":"поэтому выбор цвета здесь случаен.","voice_change":false},{"idx":23,"start_sec":55.1,"end_sec":57.19,"text":"Рассеяние, о котором мы сейчас говорим,","voice_change":false},{"idx":24,"start_sec":57.2,"end_sec":60.19,"text":"происходит благодаря столкновению света","voice_change":false},{"idx":25,"start_sec":60.2,"end_sec":62.59,"text":"с молекулами вещества. Молекула","voice_change":false},{"idx":26,"start_sec":62.6,"end_sec":65.59,"text":"поглощает порцию света и излучает такую","voice_change":false},{"idx":27,"start_sec":65.6,"end_sec":67.79,"text":"же, в каком попало направлении. И в","voice_change":false},{"idx":28,"start_sec":67.8,"end_sec":70.39,"text":"результате часть этого света доходит до","voice_change":false},{"idx":29,"start_sec":70.4,"end_sec":72.89,"text":"глаза нашего наблюдателя. Фиолетовый,","voice_change":false},{"idx":30,"start_sec":72.9,"end_sec":75.39,"text":"синий и голубой свет взаимодействуют с","voice_change":false},{"idx":31,"start_sec":75.4,"end_sec":77.39,"text":"веществами атмосферы гораздо","voice_change":false},{"idx":32,"start_sec":77.4,"end_sec":79.59,"text":"интенсивнее, чем свет других цветов.","voice_change":false},{"idx":33,"start_sec":79.6,"end_sec":82.19,"text":"Почему же небо не фиолетовое тогда?","voice_change":false},{"idx":34,"start_sec":82.2,"end_sec":84.09,"text":"Оказывается, в спектре солнца","voice_change":false},{"idx":35,"start_sec":84.1,"end_sec":86.29,"text":"фиолетового меньше, чем синего,","voice_change":false},{"idx":36,"start_sec":86.3,"end_sec":87.99,"text":"и человеческий глаз воспринимает","voice_change":false},{"idx":37,"start_sec":88.0,"end_sec":90.09,"text":"фиолетовый хуже, чем синий.","voice_change":false},{"idx":38,"start_sec":90.1,"end_sec":92.19,"text":"Давайте воспроизведём эффект голубого","voice_change":false},{"idx":39,"start_sec":92.2,"end_sec":94.59,"text":"неба, заменив солнце фонариком, а","voice_change":false},{"idx":40,"start_sec":94.6,"end_sec":96.99,"text":"атмосферу силиконовым клеем. Светить на","voice_change":false},{"idx":41,"start_sec":97.0,"end_sec":99.29,"text":"стержень нужно с некоторого расстояния,","voice_change":false},{"idx":42,"start_sec":99.3,"end_sec":100.89,"text":"чтобы интенсивность света была","voice_change":false},{"idx":43,"start_sec":100.9,"end_sec":104.29,"text":"невысокой. И тогда вот оно наше голубое","voice_change":false},{"idx":44,"start_sec":104.3,"end_sec":106.79,"text":"небо. Можно посвятить фонариком иначе,","voice_change":false},{"idx":45,"start_sec":106.8,"end_sec":108.89,"text":"не в торец, и тогда смотрите, если","voice_change":false},{"idx":46,"start_sec":108.9,"end_sec":110.99,"text":"наблюдатель вот здесь и смотрит сюда, то","voice_change":false},{"idx":47,"start_sec":111.0,"end_sec":112.69,"text":"он видит ослепительно яркое солнце, а","voice_change":false},{"idx":48,"start_sec":112.7,"end_sec":115.29,"text":"если смотрит чуть в бок, то он видит","voice_change":false},{"idx":49,"start_sec":115.3,"end_sec":117.19,"text":"синее небо.","voice_change":false},{"idx":50,"start_sec":117.2,"end_sec":119.982,"text":"Осталось вспомнить, что небо не сплошь","voice_change":false},{"idx":51,"start_sec":119.992,"end_sec":122.882,"text":"Ближе к горизонту оно белёсое. Почему","voice_change":false},{"idx":52,"start_sec":122.892,"end_sec":124.982,"text":"так? Пусть вот эта точка на схеме","voice_change":false},{"idx":53,"start_sec":124.992,"end_sec":126.682,"text":"соответствует вот этой точке у","voice_change":false},{"idx":54,"start_sec":126.692,"end_sec":129.882,"text":"горизонта. Свет от неё, уже рассеянный,","voice_change":false},{"idx":55,"start_sec":129.892,"end_sec":131.982,"text":"должен пройти до глаз наблюдателя","voice_change":false},{"idx":56,"start_sec":131.992,"end_sec":134.582,"text":"большой путь. Причём этот путь","voice_change":false},{"idx":57,"start_sec":134.592,"end_sec":137.382,"text":"в таких слоях атмосферы, которые больше","voice_change":false},{"idx":58,"start_sec":137.392,"end_sec":139.882,"text":"всего насыщены водяным паром и другими","voice_change":false},{"idx":59,"start_sec":139.892,"end_sec":142.382,"text":"крупными частицами. И на этих частицах","voice_change":false},{"idx":60,"start_sec":142.392,"end_sec":144.082,"text":"свет рассеивается не так, как на","voice_change":false},{"idx":61,"start_sec":144.092,"end_sec":146.482,"text":"молекулах. Он как белым пришёл, так","voice_change":false},{"idx":62,"start_sec":146.492,"end_sec":149.882,"text":"белым и уходит. Такое рассеяние мы можем","voice_change":false},{"idx":63,"start_sec":149.892,"end_sec":151.782,"text":"смоделировать при помощи фонарика и","voice_change":false},{"idx":64,"start_sec":151.792,"end_sec":154.982,"text":"парафина. Свет тускнеет, но на цвета не","voice_change":false},{"idx":65,"start_sec":154.992,"end_sec":157.382,"text":"раскладывается. А теперь вырежем кусок","voice_change":false},{"idx":66,"start_sec":157.392,"end_sec":159.482,"text":"этой картинки и поместим рядом с","voice_change":false},{"idx":67,"start_sec":159.492,"end_sec":161.282,"text":"изображением облака.","voice_change":false},{"idx":68,"start_sec":161.292,"end_sec":163.082,"text":"Просвечивание клея позволило нам","voice_change":false},{"idx":69,"start_sec":163.092,"end_sec":166.182,"text":"смоделировать цвет неба, просвечивание","voice_change":false},{"idx":70,"start_sec":166.192,"end_sec":168.282,"text":"парафина - цвет облака.","voice_change":false},{"idx":71,"start_sec":168.292,"end_sec":170.382,"text":"Рассеяние белого света на молекулах","voice_change":false},{"idx":72,"start_sec":170.392,"end_sec":172.882,"text":"азота и кислорода раскладывает белый","voice_change":false},{"idx":73,"start_sec":172.892,"end_sec":175.782,"text":"свет на цвета, а рассеяние на более","voice_change":false},{"idx":74,"start_sec":175.792,"end_sec":178.382,"text":"крупных частицах даёт рассеянный белый","voice_change":false},{"idx":75,"start_sec":178.392,"end_sec":180.792,"text":"свет.","voice_change":false}]}